{
  "pluginAlias": "PowerPetDoor",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Control High Tech Pet **Power Pet** Wi-Fi doors from Apple Home over your local network. Give each door a fixed IP address in your router first.",
  "footerDisplay": "Not affiliated with or endorsed by High Tech Pet Products, Inc.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "Power Pet Door"
      },
      "doors": {
        "title": "Doors",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "default": "Pet Door"
            },
            "host": {
              "title": "IP Address",
              "type": "string",
              "format": "hostname",
              "placeholder": "192.168.1.50"
            },
            "port": {
              "title": "Port",
              "type": "integer",
              "default": 3000,
              "minimum": 1
            },
            "openMode": {
              "title": "When opened from Apple Home",
              "type": "string",
              "default": "timed",
              "oneOf": [
                {
                  "title": "Open, then close automatically after the door's hold time",
                  "enum": [
                    "timed"
                  ]
                },
                {
                  "title": "Open and stay open until closed",
                  "enum": [
                    "hold"
                  ]
                }
              ]
            },
            "exposeOnOffSwitch": {
              "title": "Show the on/off switch (for \"Hey Siri, turn the door off\")",
              "type": "boolean",
              "default": true
            },
            "onOffSwitchName": {
              "title": "On/off switch name",
              "type": "string",
              "placeholder": "Dog Door",
              "description": "What you'll call it with Siri. Use a different name from the door itself."
            },
            "onOffMode": {
              "title": "When the switch is off",
              "type": "string",
              "default": "power",
              "oneOf": [
                {
                  "title": "Power off: nothing goes in or out",
                  "enum": [
                    "power"
                  ]
                },
                {
                  "title": "Inside sensor off: pets stay in, but can still come in",
                  "enum": [
                    "inside"
                  ]
                },
                {
                  "title": "Both sensors off: door won't open for collars",
                  "enum": [
                    "sensors"
                  ]
                }
              ]
            },
            "chatterGuard": {
              "title": "Turn on chatter guard",
              "type": "boolean",
              "default": false,
              "description": "Pause a sensor when the door keeps opening, for example while a pet eats next to it."
            },
            "chatterOpens": {
              "title": "Openings",
              "type": "integer",
              "default": 5,
              "minimum": 2
            },
            "chatterWindowSeconds": {
              "title": "Within (seconds)",
              "type": "integer",
              "default": 60,
              "minimum": 5
            },
            "chatterPauseMinutes": {
              "title": "Pause for (minutes)",
              "type": "integer",
              "default": 5,
              "minimum": 1
            },
            "chatterSensor": {
              "title": "Sensor to pause",
              "type": "string",
              "default": "inside",
              "oneOf": [
                {
                  "title": "Inside sensor",
                  "enum": [
                    "inside"
                  ]
                },
                {
                  "title": "Outside sensor",
                  "enum": [
                    "outside"
                  ]
                },
                {
                  "title": "Both sensors",
                  "enum": [
                    "both"
                  ]
                }
              ],
              "description": "Both sensors also stops the outside sensor from picking up a collar through the door. A pet outside when a pause starts waits until it ends to come in."
            },
            "exposeChatterGuardSwitch": {
              "title": "Chatter guard switch in Apple Home",
              "type": "boolean",
              "default": true
            },
            "scheduleMode": {
              "title": "Door's schedule",
              "type": "string",
              "default": "leave",
              "oneOf": [
                {
                  "title": "Leave it alone",
                  "enum": [
                    "leave"
                  ]
                },
                {
                  "title": "Turn it off: I'll use Apple Home automations (recommended)",
                  "enum": [
                    "off"
                  ]
                },
                {
                  "title": "Set it here",
                  "enum": [
                    "manage"
                  ]
                }
              ],
              "description": "Power Pet doors have their own schedule, often switched on from the factory. While it's on, the door turns the sensors on and off itself, which can undo changes made in Apple Home. If you schedule the door with Home app automations (for example, turn off Outside Sensor at 10 PM), choose Turn it off."
            },
            "schedules": {
              "title": "Times each sensor works",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sensor": {
                    "title": "Sensor",
                    "type": "string",
                    "default": "inside",
                    "oneOf": [
                      {
                        "title": "Inside sensor",
                        "enum": [
                          "inside"
                        ]
                      },
                      {
                        "title": "Outside sensor",
                        "enum": [
                          "outside"
                        ]
                      },
                      {
                        "title": "Both sensors",
                        "enum": [
                          "both"
                        ]
                      }
                    ]
                  },
                  "days": {
                    "title": "Days (none ticked = every day)",
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "sun",
                        "mon",
                        "tue",
                        "wed",
                        "thu",
                        "fri",
                        "sat"
                      ]
                    }
                  },
                  "start": {
                    "title": "From",
                    "type": "string"
                  },
                  "end": {
                    "title": "Until",
                    "type": "string"
                  }
                }
              },
              "description": "Replaces any schedule set in High Tech Pet's app."
            },
            "exposeActivitySensor": {
              "title": "Activity sensor (for \"door opened\" notifications)",
              "type": "boolean",
              "default": true
            },
            "exposeInsideSensor": {
              "title": "Inside sensor switch",
              "type": "boolean",
              "default": true
            },
            "exposeOutsideSensor": {
              "title": "Outside sensor switch",
              "type": "boolean",
              "default": true
            },
            "exposePower": {
              "title": "Power switch",
              "type": "boolean",
              "default": false
            },
            "exposeSchedule": {
              "title": "Schedule switch",
              "type": "boolean",
              "default": false
            },
            "exposeBattery": {
              "title": "Battery status (when a battery is installed)",
              "type": "boolean",
              "default": true
            },
            "statusPollSeconds": {
              "title": "Door status check interval (seconds)",
              "type": "integer",
              "default": 30,
              "minimum": 5
            },
            "settingsPollSeconds": {
              "title": "Settings check interval (seconds)",
              "type": "integer",
              "default": 120,
              "minimum": 15
            },
            "batteryPollSeconds": {
              "title": "Battery check interval (seconds)",
              "type": "integer",
              "default": 600,
              "minimum": 60
            },
            "timeoutSeconds": {
              "title": "Command timeout (seconds)",
              "type": "integer",
              "default": 10,
              "minimum": 2
            }
          },
          "required": [
            "name",
            "host"
          ]
        }
      }
    },
    "required": [
      "name"
    ]
  },
  "layout": [
    "name",
    {
      "key": "doors",
      "type": "array",
      "buttonText": "Add Door",
      "items": [
        {
          "type": "div",
          "displayFlex": false,
          "items": [
            "doors[].name",
            "doors[].host",
            "doors[].openMode",
            {
              "type": "fieldset",
              "title": "On/off switch",
              "expandable": true,
              "items": [
                "doors[].exposeOnOffSwitch",
                "doors[].onOffSwitchName",
                "doors[].onOffMode"
              ]
            },
            {
              "type": "fieldset",
              "title": "Chatter guard",
              "expandable": true,
              "items": [
                "doors[].chatterGuard",
                "doors[].chatterOpens",
                "doors[].chatterWindowSeconds",
                "doors[].chatterPauseMinutes",
                "doors[].chatterSensor",
                "doors[].exposeChatterGuardSwitch"
              ]
            },
            {
              "type": "fieldset",
              "title": "Door schedule",
              "expandable": true,
              "items": [
                "doors[].scheduleMode",
                {
                  "key": "doors[].schedules",
                  "type": "array",
                  "buttonText": "Add Time",
                  "items": [
                    {
                      "type": "div",
                      "displayFlex": false,
                      "items": [
                        "doors[].schedules[].sensor",
                        {
                          "key": "doors[].schedules[].days",
                          "type": "checkboxes",
                          "titleMap": [
                            {
                              "value": "sun",
                              "name": "Sun"
                            },
                            {
                              "value": "mon",
                              "name": "Mon"
                            },
                            {
                              "value": "tue",
                              "name": "Tue"
                            },
                            {
                              "value": "wed",
                              "name": "Wed"
                            },
                            {
                              "value": "thu",
                              "name": "Thu"
                            },
                            {
                              "value": "fri",
                              "name": "Fri"
                            },
                            {
                              "value": "sat",
                              "name": "Sat"
                            }
                          ]
                        },
                        {
                          "type": "flex",
                          "flex-flow": "row wrap",
                          "items": [
                            {
                              "key": "doors[].schedules[].start",
                              "type": "time",
                              "flex": "1 1 200px"
                            },
                            {
                              "key": "doors[].schedules[].end",
                              "type": "time",
                              "flex": "1 1 200px"
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "condition": {
                    "functionBody": "return model.doors && model.doors[arrayIndices[0]] && model.doors[arrayIndices[0]].scheduleMode === 'manage';"
                  }
                }
              ]
            },
            {
              "type": "fieldset",
              "title": "Accessories to show in Apple Home",
              "expandable": true,
              "items": [
                "doors[].exposeActivitySensor",
                "doors[].exposeInsideSensor",
                "doors[].exposeOutsideSensor",
                "doors[].exposePower",
                "doors[].exposeSchedule",
                "doors[].exposeBattery"
              ]
            },
            {
              "type": "fieldset",
              "title": "Advanced",
              "expandable": true,
              "items": [
                "doors[].port",
                "doors[].statusPollSeconds",
                "doors[].settingsPollSeconds",
                "doors[].batteryPollSeconds",
                "doors[].timeoutSeconds"
              ]
            }
          ]
        }
      ]
    }
  ]
}
